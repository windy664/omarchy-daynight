#!/usr/bin/env bash
# omarchy-sun-theme -- switch the Omarchy theme at real sunrise and sunset.
#
# Omarchy ships no way to follow the sun: hyprsunset only shifts colour
# temperature at a fixed hour, and the theme picker is manual. This adds a
# timer that computes today's sunrise and sunset for your coordinates and
# switches between a day theme and a night theme.
#
# Everything is computed locally (Python standard library, no pip install and
# no network access). The optional `locate` helper talks to the China
# Meteorological Administration to guess your coordinates.

set -euo pipefail

PROGRAM_NAME="omarchy-sun-theme"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$PROGRAM_NAME"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$PROGRAM_NAME"
LOCK_FILE="$STATE_DIR/pause"
CURRENT_THEME_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme.name"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE_NAME="$PROGRAM_NAME.service"
TIMER_NAME="$PROGRAM_NAME.timer"

# ---------------------------------------------------------------- defaults --

day_theme="catppuccin-latte"
night_theme="catppuccin"
latitude=""
longitude=""
timezone=""
auto_locate="0"
dawn_offset="0"
dusk_offset="0"
poll_interval="10min"
fallback_day_start="07:00"
fallback_night_start="19:00"
nightlight="off"
on_switch=""

usage() {
  cat <<EOF
$PROGRAM_NAME -- Omarchy themes that follow the sun

Usage: $PROGRAM_NAME <command>

Commands:
  run         Switch the theme if the phase changed since the last run
  status      Show today's sunrise, sunset, current theme and next switch
  install     Install the config, the systemd user units and enable the timer
  uninstall   Disable the timer and remove the systemd user units
  locate      Guess your coordinates from your public IP address
  selftest    Check the solar calculation against reference values

Config: $CONFIG_FILE
EOF
}

# ------------------------------------------------------------------ config --

load_config() {
  [[ -f $CONFIG_FILE ]] || return 0
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  cat >"$CONFIG_FILE" <<EOF
# $PROGRAM_NAME configuration
# Generated by "$PROGRAM_NAME install". Edit freely; it is read on every run.

# Theme applied between sunrise and sunset, and between sunset and sunrise.
day_theme=$day_theme
night_theme=$night_theme

# Where you are. Leave empty and run "$PROGRAM_NAME locate" to fill them in.
latitude=$latitude
longitude=$longitude
# Empty means: take the timezone from the system.
timezone=$timezone

# Set to 1 to look up the coordinates over the network on every run.
auto_locate=$auto_locate

# Shift the switch by minutes: negative switches earlier, positive later.
dawn_offset=$dawn_offset
dusk_offset=$dusk_offset

# How often the timer checks whether the phase changed.
poll_interval=$poll_interval

# Used only inside the polar circles, where the sun may never rise or set.
fallback_day_start=$fallback_day_start
fallback_night_start=$fallback_night_start

# Night light (hyprsunset) handling: off, auto.
nightlight=$nightlight

# Optional command run after every theme change.
on_switch=$on_switch
EOF
  chmod 600 "$CONFIG_FILE"
}

require_python() {
  command -v python3 >/dev/null 2>&1 || {
    echo "$PROGRAM_NAME: python3 is required" >&2
    exit 1
  }
}

# OMARCHY_PATH is missing from the systemd user manager's environment at boot,
# which is exactly when a catch-up run happens. Fix it here as well as in the
# unit file, so the script works however it is started.
setup_omarchy_env() {
  if [[ -z ${OMARCHY_PATH:-} && -r /usr/share/omarchy/default/bash/env-bootstrap ]]; then
    # shellcheck disable=SC1091
    source /usr/share/omarchy/default/bash/env-bootstrap 2>/dev/null || true
  fi
  export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
}

solar_library() {
  local candidate
  for candidate in \
    "${OMARCHY_SUN_THEME_LIB:-}" \
    "$HOME/.local/share/$PROGRAM_NAME/solar.py" \
    "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/solar.py"; do
    [[ -n $candidate && -r $candidate ]] && { echo "$candidate"; return 0; }
  done
  echo "$PROGRAM_NAME: solar.py not found (try '$PROGRAM_NAME install')" >&2
  return 1
}

solar_json() {
  local lib
  lib="$(solar_library)"
  python3 "$lib" --lat "$latitude" --lon "$longitude" --tz "$(effective_timezone)" --json "$@"
}

effective_timezone() {
  if [[ -n $timezone ]]; then
    echo "$timezone"
    return
  fi
  timedatectl show -p Timezone --value 2>/dev/null | head -1 | grep -q . && {
    timedatectl show -p Timezone --value 2>/dev/null | head -1
    return
  }
  readlink -f /etc/localtime | sed -E 's|.*/zoneinfo/||'
}

current_theme() {
  [[ -f $CURRENT_THEME_FILE ]] && head -1 "$CURRENT_THEME_FILE" | tr -d '[:space:]'
}

notify() {
  local title="$1" body="$2"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send -u low "$title" "$body" >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------ locate --

# Guess the coordinates from the public IP address. China only: the
# Meteorological Administration is reachable without a VPN and answers with
# coordinates and the local timezone.
#
# Both services reject a bare curl user agent, so one is set. The occasional
# timeout is normal on a domestic mobile connection, so the calls retry.
LOCATE_UA="Mozilla/5.0 (X11; Linux x86_64)"
LOCATE_CURL=(curl -fsS --retry 2 --retry-delay 1 --connect-timeout 6 --max-time 12 -A "$LOCATE_UA")

# The station whose name matches the city exactly, inside China.
cma_station() {
  local city="$1"
  "${LOCATE_CURL[@]}" \
    --get --data-urlencode "q=$city" https://weather.cma.cn/api/autocomplete 2>/dev/null |
    python3 -c '
import json, sys
city = sys.argv[1]
try:
    items = json.load(sys.stdin).get("data") or []
except Exception:
    items = []
for item in items:
    parts = item.split("|")
    if len(parts) >= 4 and parts[1] == city and parts[3] == "中国":
        print(parts[0])
        break
' "$city"
}

cma_coordinates() {
  local station="$1"
  "${LOCATE_CURL[@]}" \
    "https://weather.cma.cn/api/weather/view?stationid=$station" 2>/dev/null |
    python3 -c '
import json, sys
try:
    location = json.load(sys.stdin)["data"]["location"]
except Exception:
    sys.exit(1)
print(location["latitude"])
print(location["longitude"])
'
}

locate() {
  local ip_info tail station coordinates city
  local -a fields=() candidates=()

  ip_info="$("${LOCATE_CURL[@]}" https://myip.ipip.net 2>/dev/null || true)"
  if [[ $ip_info != *来自于* ]]; then
    echo "$PROGRAM_NAME: could not determine your city from the IP address" >&2
    return 1
  fi

  # "当前 IP：1.2.3.4  来自于：中国 广东 东莞  移动" -> country province city isp
  tail="${ip_info#*来自于}"
  tail="${tail//：/ }"
  tail="${tail//:/ }"
  read -r -a fields <<<"$tail"

  # The city is the field before the operator, but not every region lists all
  # four, so fall back through the province and the country.
  (( ${#fields[@]} >= 4 )) && candidates+=("${fields[2]}")
  (( ${#fields[@]} >= 3 )) && candidates+=("${fields[1]}")
  candidates+=("${fields[0]}")

  for city in "${candidates[@]}"; do
    [[ -n $city ]] || continue
    station="$(cma_station "$city")" || continue
    [[ -n $station ]] || continue
    coordinates="$(cma_coordinates "$station")" || continue
    printf '%s\n' "$coordinates"
    echo "$city"
    return 0
  done

  echo "$PROGRAM_NAME: could not find a weather station for your city" >&2
  return 1
}

maybe_locate() {
  [[ $auto_locate == "1" ]] || return 0
  local located
  located="$(locate)" || return 0
  latitude="$(printf '%s\n' "$located" | sed -n 1p)"
  longitude="$(printf '%s\n' "$located" | sed -n 2p)"
}

# --------------------------------------------------------------------- run --

desired_theme() {
  local events phase
  events="$(solar_json)" || return 1
  phase="$(printf '%s' "$events" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("phase") or "")')"

  if [[ -z $phase ]]; then
    # Polar day or polar night: fall back to fixed hours.
    local now_minute
    now_minute="$(date +%H%M | sed 's/^0//')"
    local day_start="${fallback_day_start//:/}"
    local night_start="${fallback_night_start//:/}"
    if ((10#$now_minute >= 10#$day_start && 10#$now_minute < 10#$night_start)); then
      echo "morning"
    else
      echo "evening"
    fi
    return 0
  fi

  echo "$phase"
}

switch_theme() {
  local theme="$1"
  setup_omarchy_env
  omarchy theme set "$theme"
}

apply_nightlight() {
  [[ $nightlight == "auto" ]] || return 0
  local want="$1" status enabled
  status="$(omarchy-toggle-nightlight --status 2>/dev/null || echo '{"enabled":false}')"
  enabled="$(printf '%s' "$status" | python3 -c 'import json,sys
try: print("true" if json.load(sys.stdin).get("enabled") else "false")
except Exception: print("false")')"

  if [[ $want == "on" && $enabled != "true" ]]; then
    omarchy-toggle-nightlight >/dev/null 2>&1 || true
  elif [[ $want == "off" && $enabled == "true" ]]; then
    omarchy-toggle-nightlight >/dev/null 2>&1 || true
  fi
}

cmd_run() {
  load_config
  require_python
  mkdir -p "$STATE_DIR"

  [[ -n $latitude && -n $longitude ]] || {
    echo "$PROGRAM_NAME: no coordinates configured; run '$PROGRAM_NAME locate' or edit $CONFIG_FILE" >&2
    exit 1
  }
  maybe_locate

  local phase wanted current
  phase="$(desired_theme)" || exit 1
  if [[ $phase == "morning" ]]; then
    wanted="$day_theme"
  else
    wanted="$night_theme"
  fi

  current="$(current_theme)"

  if [[ -f $LOCK_FILE ]]; then
    echo "$PROGRAM_NAME: paused ($LOCK_FILE exists), wanted $wanted, current ${current:-unknown}"
    return 0
  fi

  if [[ $current == "$wanted" ]]; then
    echo "$PROGRAM_NAME: already on $wanted"
    return 0
  fi

  echo "$PROGRAM_NAME: switching $current -> $wanted"
  switch_theme "$wanted"
  apply_nightlight "$([[ $phase == "morning" ]] && echo off || echo on)"
  [[ -n $on_switch ]] && eval "$on_switch" >/dev/null 2>&1 || true
  notify "Sun theme" "Switched to $wanted"
}

cmd_status() {
  load_config
  require_python
  [[ -n $latitude && -n $longitude ]] || {
    echo "$PROGRAM_NAME: no coordinates configured; run '$PROGRAM_NAME locate'" >&2
    exit 1
  }

  local events phase wanted current sunrise sunset
  events="$(solar_json)"
  phase="$(printf '%s' "$events" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("phase") or "")')"
  sunrise="$(printf '%s' "$events" | python3 -c 'import json,sys
d=json.load(sys.stdin); print(d["sunrise"] or "-")')"
  sunset="$(printf '%s' "$events" | python3 -c 'import json,sys
d=json.load(sys.stdin); print(d["sunset"] or "-")')"
  wanted="$([[ $phase == "morning" ]] && echo "$day_theme" || echo "$night_theme")"
  current="$(current_theme)"

  echo "location   $latitude, $longitude ($(effective_timezone))"
  echo "sunrise    $sunrise"
  echo "sunset     $sunset"
  echo "phase      ${phase:-unknown}"
  echo "theme now  ${current:-unknown}"
  echo "theme want $wanted"
  if [[ -f $LOCK_FILE ]]; then
    echo "state      paused"
  fi
  echo "timer      $(systemctl --user is-active "$TIMER_NAME" 2>/dev/null || echo unknown)"
}

# ----------------------------------------------------------------- install --

write_units() {
  mkdir -p "$UNIT_DIR"
  cat >"$UNIT_DIR/$SERVICE_NAME" <<EOF
[Unit]
Description=Omarchy theme switch driven by real sunrise and sunset
Documentation=https://github.com/windy664/$PROGRAM_NAME
After=default.target

[Service]
Type=oneshot
# The systemd user manager does not have OMARCHY_PATH at boot, which is when
# a catch-up run happens. Without this the theme lookup fails with
# "Theme '...' does not exist".
Environment=OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
ExecStart=$HOME/.local/bin/$PROGRAM_NAME run
EOF

  cat >"$UNIT_DIR/$TIMER_NAME" <<EOF
[Unit]
Description=Check the sun phase every $poll_interval and switch the Omarchy theme

[Timer]
OnBootSec=3min
OnUnitActiveSec=$poll_interval
AccuracySec=1min
Unit=$SERVICE_NAME

[Install]
WantedBy=timers.target
EOF
}

install_files() {
  local source_dir
  source_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
  mkdir -p "$HOME/.local/bin" "$HOME/.local/share/$PROGRAM_NAME"
  install -m 0755 "$source_dir/bin/$PROGRAM_NAME" "$HOME/.local/bin/$PROGRAM_NAME"
  install -m 0644 "$source_dir/lib/solar.py" "$HOME/.local/share/$PROGRAM_NAME/solar.py"
  install -m 0644 "$source_dir/test/solar_test.py" "$HOME/.local/share/$PROGRAM_NAME/solar_test.py"
}

cmd_install() {
  local migrate_legacy=0
  [[ ${1:-} == "--migrate-legacy" ]] && migrate_legacy=1

  require_python
  load_config

  if [[ -z $latitude || -z $longitude ]]; then
    echo "$PROGRAM_NAME: looking up your coordinates..."
    if located="$(locate)"; then
      latitude="$(printf '%s\n' "$located" | sed -n 1p)"
      longitude="$(printf '%s\n' "$located" | sed -n 2p)"
      echo "$PROGRAM_NAME: found $(printf '%s\n' "$located" | sed -n 3p) ($latitude, $longitude)"
    else
      echo "$PROGRAM_NAME: could not look them up; edit $CONFIG_FILE by hand" >&2
    fi
  fi

  save_config
  install_files
  write_units

  systemctl --user daemon-reload
  systemctl --user enable --now "$TIMER_NAME"

  if [[ $migrate_legacy == "1" ]]; then
    for legacy in theme-day.timer theme-night.timer; do
      if systemctl --user list-unit-files "$legacy" >/dev/null 2>&1 &&
        systemctl --user is-enabled "$legacy" >/dev/null 2>&1; then
        systemctl --user disable --now "$legacy" >/dev/null 2>&1 || true
        echo "$PROGRAM_NAME: disabled the legacy $legacy"
      fi
    done
  fi

  echo
  echo "$PROGRAM_NAME installed."
  echo "  config  $CONFIG_FILE"
  echo "  timer   $TIMER_NAME (every $poll_interval)"
  echo
  "$PROGRAM_NAME" status || true
}

cmd_uninstall() {
  systemctl --user disable --now "$TIMER_NAME" >/dev/null 2>&1 || true
  rm -f "$UNIT_DIR/$SERVICE_NAME" "$UNIT_DIR/$TIMER_NAME"
  systemctl --user daemon-reload
  echo "$PROGRAM_NAME removed. Your config is still in $CONFIG_FILE."
}

cmd_selftest() {
  require_python
  local lib test_file
  lib="$(solar_library)" || return 1
  test_file="$(dirname "$lib")/solar_test.py"
  [[ -f $test_file ]] || test_file="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../test/solar_test.py"
  [[ -f $test_file ]] || {
    echo "$PROGRAM_NAME: the test file is not installed" >&2
    return 1
  }
  python3 "$test_file"
}

case "${1:-}" in
  run) cmd_run ;;
  status) cmd_status ;;
  install) shift; cmd_install "${1:-}" ;;
  uninstall) cmd_uninstall ;;
  locate) locate ;;
  selftest) cmd_selftest ;;
  "" | -h | --help | help) usage ;;
  *)
    echo "$PROGRAM_NAME: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
